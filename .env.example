# --- Database (PostgreSQL) ---------------------------------------------------
# Leave DATABASE_URL unset to run the dashboard against in-memory demo fixtures.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesquared_os?schema=public"

# --- AI qualification --------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to use the rule-based stub classifier.
ANTHROPIC_API_KEY=""
# Model used for lead qualification. Defaults to claude-opus-5-5.
QUALIFIER_MODEL="claude-opus-5-5"

# --- Platform ----------------------------------------------------------------
# Public base URL of this deployment (used when generating booking links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Per-tenant secrets (Square tokens, Meta/TikTok/YouTube/LinkedIn tokens, Cal.com keys)
# are NOT environment variables. They live on the tenant's integration rows and are
# configured from the operator dashboard.

# --- Operator sign-in ----------------------------------------------------------
# Secret for signing session cookies (16+ random characters). Required in production.
AUTH_SECRET=""
# Demo-mode operator password (operator@example.com). Ignored when DATABASE_URL is set.
DEMO_OPERATOR_PASSWORD="mesquared-demo"
# Password for the seeded operator@example.com user. Leave blank to generate one (printed once).
SEED_OPERATOR_PASSWORD=""
