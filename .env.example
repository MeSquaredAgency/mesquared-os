# --- Database (PostgreSQL) ---------------------------------------------------
# Leave DATABASE_URL unset to run the dashboard against in-memory demo fixtures.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesquared_os?schema=public"

# --- AI qualification --------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to use the rule-based stub classifier.
ANTHROPIC_API_KEY=""
# Model used for lead qualification. Defaults to claude-opus-5-5.
QUALIFIER_MODEL="claude-opus-5-5"

# --- Platform ----------------------------------------------------------------
# Public base URL of this deployment (used when generating booking links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Per-tenant secrets (Square tokens, Meta/TikTok/YouTube/LinkedIn tokens, Cal.com keys)
# are NOT environment variables. They live on the tenant's integration rows and are
# configured from the operator dashboard.

# --- Operator sign-in ----------------------------------------------------------
# Secret for signing session cookies (16+ random characters). Required in production.
AUTH_SECRET=""
# Demo-mode operator password (operator@example.com). Ignored when DATABASE_URL is set.
DEMO_OPERATOR_PASSWORD="mesquared-demo"
# Password for the seeded operator@example.com user. Leave blank to generate one (printed once).
SEED_OPERATOR_PASSWORD=""

# --- Production safety -----------------------------------------------------------
# Demo mode (in-memory data, public demo API keys) is refused in production unless
# explicitly requested. Never set this on a real deployment.
DATA_MODE=""
# Required in production: public base URL used in booking links.
# NEXT_PUBLIC_APP_URL is declared above.
# Number of trusted reverse proxies in front of the app (for client IP detection).
TRUSTED_PROXY_HOPS="1"
# Intake requests allowed per minute per workspace (token bucket).
INTAKE_RATE_LIMIT_PER_MINUTE="60"
# The seed script refuses to run in production unless this is "true".
ALLOW_PRODUCTION_SEED=""

# --- Scheduled jobs --------------------------------------------------------------
# Bearer secret for POST /api/jobs/* (missed-opportunity detection etc.). Required to run jobs.
JOB_SECRET=""
# A platform-admin user the jobs act as, to enumerate every active tenant.
JOB_ACTOR_EMAIL="operator@example.com"

# --- Messaging (platform providers; each tenant still sends under its own identity) ----
# Twilio for SMS/WhatsApp. Tenants set their own from-number on their TWILIO integration.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
DEFAULT_FROM_NUMBER=""
# Resend for email. Tenants set replyTo in branding; this is the fallback from-address.
RESEND_API_KEY=""
DEFAULT_FROM_EMAIL=""
# Set to "log" to print messages instead of sending (tests, local demos).
MESSAGING_MODE=""

# --- Intake channels ---------------------------------------------------------------
# Meta app secret (webhook signatures) and the token you choose for the verification handshake.
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
# Fallback page access token when a tenant's META integration has none stored.
META_PAGE_ACCESS_TOKEN=""
# Bearer secret your inbound-email provider sends to POST /api/v1/inbound/email.
INBOUND_EMAIL_SECRET=""
# Cal.com webhook signing secret (x-cal-signature-256).
CALCOM_WEBHOOK_SECRET=""
# Key for encrypting integration credentials at rest (16+ random characters). Required in production.
INTEGRATION_ENCRYPTION_KEY=""
