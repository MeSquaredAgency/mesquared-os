{
  "name": "mesquared-os",
  "version": "0.1.0",
  "private": true,
  "description": "MeSquared OS \u2014 multi-tenant B2B operations, social marketing and revenue platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --import ./src/test/setup.mjs --test \"src/test/*.test.ts\"",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev --port 8787",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:local": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "tenant:provision": "node --env-file-if-exists=.env.neon.local --experimental-strip-types --no-warnings --import ./src/test/setup.mjs scripts/provision.ts",
    "db:parity": "node --experimental-strip-types --no-warnings --import ./src/test/setup.mjs scripts/parity-check.ts",
    "neon:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.neon.local --experimental-strip-types --no-warnings --import ./src/test/setup.mjs scripts/neon-check.ts",
    "inventory:import": "node --env-file-if-exists=.env.neon.local --experimental-strip-types --no-warnings --import ./src/test/setup.mjs scripts/import-inventory.ts",
    "tenant:connect-inventory": "node --env-file-if-exists=.env.neon.local --experimental-strip-types --no-warnings --import ./src/test/setup.mjs scripts/connect-inventory.ts",
    "tenant:connect-meta": "node --env-file-if-exists=.env.neon.local --experimental-strip-types --no-warnings --import ./src/test/setup.mjs scripts/connect-meta.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "prisma": {
    "seed": "node --experimental-strip-types --no-warnings --import ./src/test/setup.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.1.2",
    "@neon/realtime-react": "^0.1.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^0.546.0",
    "next": "^15.5.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.2.0",
    "square": "^43.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0",
    "ws": "^8.22.0"
  }
}
