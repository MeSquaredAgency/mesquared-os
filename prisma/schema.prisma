// MeSquared OS — core data model (Phase 0 re-foundation)
//
// Multi-tenancy rule: every operational entity carries a `tenantId` and is
// only ever read or written through a tenant-scoped query. No client-specific
// code, branding or rules live in source: they live on the Tenant row, its
// configuration rows, and are seeded from industry templates.
//
// See docs/product-spec.md and docs/architecture.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection for Prisma Migrate. `neon deploy` / `neon env pull` write it; locally make it the same value as DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Identity, access and tenancy
// ---------------------------------------------------------------------------

/// Platform-level person. Tenant users and Me² operators are both Users.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  avatarUrl       String?
  passwordHash    String?
  /// Bumped on password change or "sign out everywhere"; sessions carry it and must match.
  sessionVersion  Int      @default(0)
  /// Me² staff who work tenants through the Operator Console.
  isOperator      Boolean  @default(false)
  /// Sees every tenant; implies operator.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships         Membership[]
  operatorAssignments OperatorAssignment[]
  assignedLeads       Lead[]          @relation("LeadAssignee")
  assignedExceptions  ExceptionItem[] @relation("ExceptionOperator")
  escalatedExceptions ExceptionItem[] @relation("ExceptionEscalatedTo")
  approvedAssets      ContentAsset[]  @relation("AssetApprover")
}

/// Fixed capabilities. Tenants name their own roles; the permissions underneath never change.
enum Permission {
  VIEW_FINANCES
  APPROVE_CONTENT
  RECEIVE_LEAD_ALERTS
  MANAGE_USERS
  VIEW_ALL_RECORDS
}

/// A tenant-named role, e.g. "Property Manager", carrying a set of permissions.
model TenantRole {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  /// Which template this was seeded from (owner, manager, staff, accountant), if any.
  templateKey String?
  permissions Permission[] @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, name])
}

/// A user's seat in a tenant, with the role that decides what they may do and see.
model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  /// Signature details for messages signed by this person: job title, mobile, hosted photo.
  title     String?
  phone     String?
  photoUrl  String?
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   TenantRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
}

/// Me² operators are assigned to tenants; the console portfolio is built from these.
model OperatorAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

enum Industry {
  REAL_ESTATE
  HEALTH_FITNESS
  GENERIC
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  industry  Industry @default(GENERIC)
  /// Which industry template was applied; configuration can diverge afterwards.
  templateKey String?
  /// ISO 3166-1 alpha-2 of the business's home region; drives messaging consent rules and defaults.
  region    String   @default("AU")
  timezone  String   @default("UTC")
  /// BCP 47 tag used for date and number formatting in the dashboard.
  locale    String   @default("en-AU")
  currency  String   @default("USD")
  /// Dynamic branding: { logoUrl, primaryColor, accentColor, fromName, replyTo }
  branding  Json     @default("{}")
  /// Tenant-configured qualification rules consumed by the classifier (see QualificationRules in src/lib/types.ts).
  qualificationRules Json @default("{}")
  /// Service levels: { firstResponseMinutes, bookingWindowHours, quietHours: {start,end} }
  sla       Json     @default("{}")
  /// What escalates to a named client person instead of an operator: { rules: [{ when, notifyUserId }] }
  escalationRules Json @default("{}")
  /// Estimated values per missed-opportunity type, in minor units: { NOT_BOOKED: 150000, ... }
  opportunityValues Json @default("{}")
  /// Free-form operational settings.
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles               TenantRole[]
  memberships         Membership[]
  operatorAssignments OperatorAssignment[]
  apiKeys             TenantApiKey[]
  modules             TenantModule[]
  integrations        Integration[]
  brandProfile        BrandProfile?
  pipelines           Pipeline[]
  stages              PipelineStage[]
  contacts            Contact[]
  leads               Lead[]
  intakeEvents        IntakeEvent[]
  conversations       Conversation[]
  messages            Message[]
  bookings            Booking[]
  missedOpportunities MissedOpportunity[]
  automations         TenantAutomation[]
  automationRuns      AutomationRun[]
  aiUsage             AiUsage[]
  agents              TenantAgent[]
  agentRuns           AgentRun[]
  exceptions          ExceptionItem[]
  events              DomainEvent[]
  channels            Channel[]
  channelMetrics ChannelMetricSnapshot[]
  adAccounts     AdAccount[]
  adSpend        AdSpendSnapshot[]
  invoices       Invoice[]
  trackedLinks   TrackedLink[]
  webEvents      WebEvent[]
  siteMetrics    SiteMetricSnapshot[]
  contentAssets       ContentAsset[]
  socialPosts         SocialPost[]
  socialProofAssets   SocialProofAsset[]
  transactions        Transaction[]
  inventoryItems      InventoryItem[]
  scheduledActions    ScheduledAction[]
  informationRequests InformationRequest[]
  reviews             Review[]
  formSessions        FormSession[]
}

/// Inbound API keys used by web forms / landing pages / relays to post into /api/v1/intake. Only a hash is stored.
model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  label      String
  keyHash    String    @unique
  keyPrefix  String
  /// What the key may do: "intake" (public web forms, call tracking, reviews) and/or "content" (uploads, source material). Intake keys sit in public pages by design, so content needs its own key.
  scopes     String[]  @default(["intake"])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Configuration: modules, integrations, brand
// ---------------------------------------------------------------------------

/// A platform module switched on for a tenant, with its settings. Keys are declared in src/lib/modules.
model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  moduleKey String
  enabled   Boolean  @default(false)
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
}

enum IntegrationProvider {
  CALCOM
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  META
  GOOGLE_ADS
  GOOGLE_LEAD_FORMS
  TIKTOK
  YOUTUBE
  LINKEDIN
  GOOGLE_BUSINESS
  SQUARE
  STRIPE
  XERO
  QUICKBOOKS
  TWILIO
  RESEND
  WHATSAPP
  REA
  DOMAIN
  PROPERTY_MANAGEMENT
  EMAIL_FORWARDING
  CALL_TRACKING
  WEBSITE
  OTHER
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  NEEDS_ATTENTION
  DISCONNECTED
}

/// One connected external system per tenant. Credentials are encrypted by the application layer.
model Integration {
  id                String              @id @default(cuid())
  tenantId          String
  provider          IntegrationProvider
  label             String?
  status            IntegrationStatus   @default(PENDING)
  externalAccountId String?
  credentialsEnc    String?
  scopes            String[]            @default([])
  settings          Json                @default("{}")
  lastSyncAt        DateTime?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channels Channel[]

  /// An external account (Meta page, inbox address, phone number) belongs to exactly one tenant.
  @@unique([provider, externalAccountId])
  @@index([tenantId, provider])
  @@index([tenantId, status])
}

/// Voice, examples, banned phrases and the compliance block the content engine enforces on every asset.
model BrandProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  voice          String?
  examples       String[] @default([])
  bannedPhrases  String[] @default([])
  /// { requiredFooter, prohibitedCombinations[], claimsPolicy, mustNot[] }
  complianceBlock Json    @default("{}")
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Contacts, pipelines, leads
// ---------------------------------------------------------------------------

/// A person or organisation the business deals with. Leads, conversations and payments hang off it.
model Contact {
  id             String    @id @default(cuid())
  tenantId       String
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  company        String?
  /// Per-channel consent: { sms: { granted, at, source }, email: {...}, whatsapp: {...} }
  consent        Json      @default("{}")
  tags           String[]  @default([])
  lastActivityAt DateTime?
  /// Set when the contact has been inactive long enough to count as lapsed.
  lapsedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads               Lead[]
  conversations       Conversation[]
  intakeEvents        IntakeEvent[]
  missedOpportunities MissedOpportunity[]
  automationRuns      AutomationRun[]
  exceptions          ExceptionItem[]
  agentRuns           AgentRun[]
  transactions        Transaction[]
  invoices     Invoice[]
  informationRequests InformationRequest[]

  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, lastActivityAt])
}

model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  leads  Lead[]

  @@unique([tenantId, key])
}

/// What moves a lead into the next stage automatically.
enum StageAdvanceTrigger {
  MANUAL
  BOOKING_CREATED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  DOCUMENT_SIGNED
}

model PipelineStage {
  id         String              @id @default(cuid())
  tenantId   String
  pipelineId String
  key        String
  name       String
  order      Int
  /// Event that advances a lead *into* this stage.
  advanceOn  StageAdvanceTrigger @default(MANUAL)
  isWon      Boolean             @default(false)
  isLost     Boolean             @default(false)
  /// Days of silence in this stage before a lead counts as a quote/proposal gone quiet. Null = not watched.
  quietAfterDays Int?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, key])
  @@index([tenantId])
}

/// GREEN = revenue intent ("Needs you"). RED = admin ("Handled for you"). Internal names only.
enum TicketType {
  GREEN
  RED
}

enum LeadSource {
  WEB_FORM
  LANDING_PAGE
  META_LEAD_FORM
  GOOGLE_LEAD_FORM
  TIKTOK_LEAD_FORM
  LINKEDIN_LEAD_FORM
  SOCIAL_DM
  SOCIAL_COMMENT
  PORTAL_EMAIL
  YOUTUBE
  REFERRAL
  PHONE
  EMAIL
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  QUALIFIED
  BOOKING_SENT
  BOOKED
  NURTURING
  WON
  LOST
  ARCHIVED
}

/// An opportunity on a contact, moving through a pipeline.
model Lead {
  id          String     @id @default(cuid())
  tenantId    String
  contactId   String?
  pipelineId  String?
  stageId     String?
  assigneeId  String?
  source      LeadSource @default(OTHER)
  /// Idempotency key from the upstream system (form submission id, ad lead id).
  externalId  String?
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  company     String?
  message     String?
  /// Normalised answers (budget, timeline, service, etc.) used by the classifier.
  attributes  Json       @default("{}")
  /// Campaign attribution stamped at intake: { source, medium, campaign, content, term, clickId }
  attribution Json       @default("{}")

  status      LeadStatus @default(NEW)
  ticketType  TicketType?
  intentScore Int?
  qualificationReason String?
  qualifiedAt DateTime?
  qualifiedBy String?

  /// Estimated value of the opportunity, in minor units.
  valueCents      Int       @default(0)
  /// SLA deadlines computed at intake from tenant config.
  respondBy       DateTime?
  bookBy          DateTime?
  firstResponseAt DateTime?
  bookedAt        DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lifetimeValueCents Int    @default(0)
  /// When the lead entered its current stage; drives "quote gone quiet".
  stageEnteredAt  DateTime?
  /// Last inbound or outbound activity on this lead.
  lastActivityAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact             Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline            Pipeline?           @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage               PipelineStage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignee            User?               @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  bookings            Booking[]
  intakeEvents        IntakeEvent[]
  missedOpportunities MissedOpportunity[]
  automationRuns      AutomationRun[]
  exceptions          ExceptionItem[]
  notes               LeadNote[]
  agentRuns           AgentRun[]
  transactions        Transaction[]
  informationRequests InformationRequest[]

  @@unique([tenantId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, ticketType, createdAt])
  @@index([tenantId, assigneeId])
  @@index([tenantId, respondBy])
  @@index([tenantId, bookBy])
  @@index([tenantId, stageId])
  @@index([contactId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

// ---------------------------------------------------------------------------
// Intake and conversations
// ---------------------------------------------------------------------------

enum IntakeChannel {
  WEB_FORM
  META_LEAD_FORM
  GOOGLE_LEAD_FORM
  SOCIAL_DM
  SOCIAL_COMMENT
  EMAIL_FORWARD
  CALL
  VOICEMAIL
  PORTAL_EMAIL
  API
}

enum IntakeOutcome {
  CREATED
  DUPLICATE
  REJECTED
}

/// One normalised event per inbound item from any channel. `payload` is the redacted raw body, kept once here.
model IntakeEvent {
  id         String        @id @default(cuid())
  tenantId   String
  channel    IntakeChannel @default(API)
  provider   String?
  externalId String?
  contactId  String?
  leadId     String?
  outcome    IntakeOutcome
  payload    Json
  classifier String?
  createdAt  DateTime      @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

enum MessageChannel {
  SMS
  EMAIL
  WHATSAPP
  SOCIAL_DM
  SOCIAL_COMMENT
  PHONE
}

/// One thread per contact per channel. The unified inbox and the forwarding inbox both read from here.
model Conversation {
  id            String         @id @default(cuid())
  tenantId      String
  contactId     String?
  channel       MessageChannel
  subject       String?
  externalId    String?
  lastMessageAt DateTime?
  /// True while the last message is inbound and nobody has replied.
  awaitingReply Boolean        @default(false)
  /// Social inbox threads: the platform and channel they arrived on, provider ids needed to reply, the other party's display name.
  platform       SocialPlatform?
  channelId      String?
  meta           Json           @default("{}")
  displayName    String?
  /// Drafted by the triage automation for a person to send with one click.
  suggestedReply String?
  createdAt     DateTime       @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  socialChannel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  messages Message[]

  /// One thread per provider thread id per channel (DM conversation, commented post).
  @@unique([tenantId, channel, externalId])
  @@index([tenantId, awaitingReply, lastMessageAt])
  @@index([tenantId, channel, contactId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CONTACT
  AUTOMATION
  OPERATOR
  CLIENT_STAFF
  /// Written by a Claude agent (src/lib/agents), sent under the business's name like an automation.
  AGENT
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  conversationId    String
  direction         MessageDirection
  sender            MessageSender
  /// Destination for outbound messages (E.164 or email), for per-recipient caps.
  to                String?
  body              String
  status            MessageStatus    @default(QUEUED)
  providerMessageId String?
  automationRunId   String?
  /// Set by a caller that may retry (an agent step): a second send with the same key returns the first instead.
  idempotencyKey    String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  automationRun AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, direction, createdAt])
  @@index([tenantId, to, createdAt])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

enum BookingProvider {
  CALCOM
  GOOGLE_CALENDAR
  MANUAL
}

enum BookingStatus {
  /// Link generated, delivery not yet confirmed by the messaging adapter.
  LINK_PENDING
  LINK_SENT
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Booking {
  id         String          @id @default(cuid())
  tenantId   String
  leadId     String
  provider   BookingProvider @default(CALCOM)
  externalId String?
  bookingUrl String?
  startsAt   DateTime?
  endsAt     DateTime?
  status     BookingStatus   @default(LINK_PENDING)
  /// Lifecycle stamps set by the booking_lifecycle automation.
  confirmedAt  DateTime?
  remindedAt   DateTime?
  followedUpAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([tenantId, leadId, createdAt])
}

/// Work an automation decided to do later: a reminder, a follow-up, a review request, a chase. Processed by the jobs tick.
model ScheduledAction {
  id        String   @id @default(cuid())
  tenantId  String
  typeKey   String
  /// Discriminator inside the type, e.g. "reminder" | "follow_up" | "auto_complete".
  action    String
  runAt     DateTime
  payload   Json     @default("{}")
  /// Idempotency: one pending action per (subject, action).
  dedupeKey String
  status    ScheduledActionStatus @default(PENDING)
  attempts  Int      @default(0)
  lastError String?
  /// Set when a tick claims the row; a claim older than the lease is reclaimable.
  lockedAt  DateTime?
  createdAt DateTime @default(now())
  ranAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([status, runAt])
}

enum ScheduledActionStatus {
  PENDING
  RUNNING
  DONE
  CANCELLED
  FAILED
}

enum InformationRequestStatus {
  OPEN
  RECEIVED
  CANCELLED
  ESCALATED
}

/// Something the business is waiting on from a contact: a document, a signature, a completed application.
model InformationRequest {
  id           String                   @id @default(cuid())
  tenantId     String
  contactId    String?
  leadId       String?
  kind         String
  description  String
  dueAt        DateTime?
  status       InformationRequestStatus @default(OPEN)
  chaseCount   Int                      @default(0)
  lastChasedAt DateTime?
  receivedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, lastChasedAt])
}

/// A public review (Google, Facebook, portal). Unanswered ones are a missed opportunity.
model Review {
  id         String    @id @default(cuid())
  tenantId   String
  provider   String
  externalId String
  authorName String?
  rating     Int?
  body       String?
  url        String?
  receivedAt DateTime  @default(now())
  repliedAt  DateTime?
  replyBody  String?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, repliedAt])
}

/// A website form someone started. Partial contact details are captured so an abandoned form can be recovered.
model FormSession {
  id              String    @id @default(cuid())
  tenantId        String
  sessionKey      String
  formName        String?
  pageUrl         String?
  partial         Json      @default("{}")
  startedAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  submittedAt     DateTime?
  convertedLeadId String?
  /// Set once an abandoned-form opportunity has been raised, so it is raised once.
  flaggedAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionKey])
  @@index([tenantId, submittedAt, lastSeenAt])
}

// ---------------------------------------------------------------------------
// Missed opportunities, automation, exceptions, events
// ---------------------------------------------------------------------------

enum MissedOpportunityType {
  UNANSWERED_ENQUIRY
  MISSED_CALL
  ABANDONED_FORM
  NOT_BOOKED
  NO_SHOW
  QUIET_QUOTE
  UNREPLIED_DM
  UNREPLIED_COMMENT
  UNANSWERED_REVIEW
  LAPSED_CUSTOMER
}

enum MissedOpportunityStatus {
  DETECTED
  RECOVERING
  RECOVERED
  ESCALATED
  EXPIRED
}

/// Revenue leaking out of the business, detected continuously and recovered automatically or by an operator.
model MissedOpportunity {
  id                  String                  @id @default(cuid())
  tenantId            String
  type                MissedOpportunityType
  status              MissedOpportunityStatus @default(DETECTED)
  contactId           String?
  leadId              String?
  estimatedValueCents Int                     @default(0)
  recoveredValueCents Int                     @default(0)
  summary             String
  detectedAt          DateTime                @default(now())
  resolvedAt          DateTime?
  /// Idempotency: one open item per (lead or contact, type).
  dedupeKey           String

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead      Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  exception ExceptionItem?
  runs      AutomationRun[]
  agentRuns AgentRun[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, detectedAt])
  @@index([tenantId, leadId, status])
  @@index([tenantId, contactId, status])
}

/// A reusable automation type switched on for a tenant. Types are declared in src/lib/automations.
model TenantAutomation {
  id        String   @id @default(cuid())
  tenantId  String
  typeKey   String
  enabled   Boolean  @default(false)
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, typeKey])
}

enum AutomationOutcome {
  SENT
  COMPLETED
  SKIPPED
  ESCALATED
  FAILED
}

/// How far an agent may act on its own: SHADOW proposes and never acts; SUGGEST runs reads and drafts and asks for
/// everything else; SUPERVISED also runs internal changes and asks before anything a customer sees; DELEGATED also
/// runs the external actions a tenant names. See src/lib/agents/policy.ts.
enum AgentAutonomy {
  SHADOW
  SUGGEST
  SUPERVISED
  DELEGATED
}

/// One agent role switched on for one tenant: the role is code (src/lib/agents/roles.ts), this row is the tenant's
/// use of it. toolPolicy maps a tool name to "auto", "ask" or "off".
model TenantAgent {
  id                  String        @id @default(cuid())
  tenantId            String
  roleKey             String
  enabled             Boolean       @default(false)
  autonomy            AgentAutonomy @default(SHADOW)
  toolPolicy          Json          @default("{}")
  instructions        String        @default("")
  settings            Json          @default("{}")
  model               String?
  monthlyBudgetMicros BigInt?
  runTokenCap         Int?
  schedule            Json          @default("{}")
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleKey])
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING
  /// A person paused it from the run's page; nothing happens until they resume it.
  PAUSED
  DONE
  FAILED
  CANCELLED
}

enum AgentToolCallStatus {
  PENDING
  AWAITING_APPROVAL
  APPROVED
  DONE
  ERROR
  PROPOSED
  REFUSED
  REJECTED
  EXPIRED
}

/// One piece of work an agent does (src/lib/agents/runtime.ts). QUEUED and stale RUNNING runs are picked up by
/// /api/jobs/agents; WAITING runs are parked on a person. Tokens and cost are the run's own totals; the ledger
/// (AiUsage) has a row per call as well.
model AgentRun {
  id                  String         @id @default(cuid())
  tenantId            String
  roleKey             String
  status              AgentRunStatus @default(QUEUED)
  /// What started it, e.g. "missed_opportunity"; one trigger starts one run through dedupeKey.
  trigger             String
  dedupeKey           String?
  /// The autonomy the run worked under at its latest step.
  autonomy            AgentAutonomy
  model               String
  steps               Int            @default(0)
  tokens              Int            @default(0)
  costMicros          BigInt         @default(0)
  /// Failures of the current step in a row; reset when a step succeeds.
  attempts            Int            @default(0)
  nextStepAt          DateTime       @default(now())
  lockedAt            DateTime?
  summary             String?
  error               String?
  leadId              String?
  contactId           String?
  missedOpportunityId String?
  finishedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead              Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  missedOpportunity MissedOpportunity? @relation(fields: [missedOpportunityId], references: [id], onDelete: SetNull)
  messages          AgentMessage[]
  toolCalls         AgentToolCall[]
  guidance          AgentGuidance[]
  exceptions        ExceptionItem[]

  @@unique([tenantId, dedupeKey])
  @@index([status, nextStepAt])
  @@index([tenantId, createdAt])
}

/// The run's conversation with Claude, append-only: content is the Messages API blocks exactly as sent or received,
/// thinking blocks and their signatures included, because they must go back unchanged.
model AgentMessage {
  id         String   @id @default(cuid())
  tenantId   String
  runId      String
  seq        Int
  role       String
  content    Json
  stopReason String?
  createdAt  DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
}

/// One tool call the model asked for, with the policy's decision and, once there is one, the result it was given.
model AgentToolCall {
  id          String              @id @default(cuid())
  tenantId    String
  runId       String
  toolUseId   String
  name        String
  input       Json
  /// What ran instead, when the person approving edited the input; the transcript keeps what the model asked for.
  editedInput Json?
  /// Why only the client may approve it (a price, a complaint…), decided when it was asked; null when an operator may.
  signoff     String?
  risk        String
  decision    String
  reason      String
  status      AgentToolCallStatus
  result      Json?
  isError     Boolean             @default(false)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  run       AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  exception ExceptionItem?

  @@unique([runId, toolUseId])
  @@index([tenantId, status])
}

/// A note on a lead for whoever deals with them next. A CALL_BRIEF is what to know before calling: who they are,
/// what they asked, the property, a suggested opener. Agents write them; the newest brief is the one shown.
model LeadNote {
  id          String   @id @default(cuid())
  tenantId    String
  leadId      String
  kind        String
  body        String
  /// "AGENT" or "USER".
  authorType  String
  agentRunId  String?
  createdById String?
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
}

/// Guidance a person added to a run while it worked. It reaches the model in the next turn the runtime writes,
/// and deliveredSeq is that turn, so each note is delivered once.
model AgentGuidance {
  id           String   @id @default(cuid())
  tenantId     String
  runId        String
  text         String
  createdById  String
  deliveredSeq Int?
  createdAt    DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

/// One row per Claude call: what it was for and what it cost (src/lib/ai/claude.ts).
/// costMicros is millionths of a US dollar at the list price when the call was made.
model AiUsage {
  id               String   @id @default(cuid())
  tenantId         String
  feature          String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheWriteTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  costMicros       BigInt
  latencyMs        Int
  stopReason       String?
  requestId        String?
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Every automation execution. `summary` is the human line that "Handled for you" shows.
model AutomationRun {
  id                  String            @id @default(cuid())
  tenantId            String
  typeKey             String
  outcome             AutomationOutcome
  summary             String
  details             Json              @default("{}")
  contactId           String?
  leadId              String?
  missedOpportunityId String?
  createdAt           DateTime          @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead              Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  missedOpportunity MissedOpportunity? @relation(fields: [missedOpportunityId], references: [id], onDelete: SetNull)
  messages          Message[]

  @@index([tenantId, createdAt])
  @@index([tenantId, typeKey])
  @@index([tenantId, contactId, typeKey, createdAt])
}

enum ExceptionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// The operator queue: anything automation is not confident about, or that tenant rules escalate to a named person.
model ExceptionItem {
  id                  String          @id @default(cuid())
  tenantId            String
  reason              String
  suggestedAction     String?
  confidence          Float?
  status              ExceptionStatus @default(OPEN)
  assignedOperatorId  String?
  escalatedToUserId   String?
  contactId           String?
  leadId              String?
  missedOpportunityId String?         @unique
  /// Raised by an agent run (a failure, a budget stop); and, for an approval, the one tool call it asks about.
  agentRunId          String?
  agentToolCallId     String?         @unique
  resolution          String?
  resolvedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedOperator  User?              @relation("ExceptionOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)
  escalatedTo       User?              @relation("ExceptionEscalatedTo", fields: [escalatedToUserId], references: [id], onDelete: SetNull)
  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead              Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  missedOpportunity MissedOpportunity? @relation(fields: [missedOpportunityId], references: [id], onDelete: SetNull)
  agentRun          AgentRun?          @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agentToolCall     AgentToolCall?     @relation(fields: [agentToolCallId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([assignedOperatorId, status])
}

/// Append-only stream every module subscribes to: automations, detectors, pipeline advancement, the activity log.
model DomainEvent {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  payload     Json     @default("{}")
  causationId String?
  occurredAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, type])
}

// ---------------------------------------------------------------------------
// Content and social (kept from the first build; extended in Phase 3)
// ---------------------------------------------------------------------------

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
  GOOGLE_BUSINESS
}

/// A connected destination (page, IG account, channel, GBP listing) under an Integration.
model Channel {
  id                String         @id @default(cuid())
  tenantId          String
  integrationId     String?
  platform          SocialPlatform
  externalAccountId String
  displayName       String?
  isActive          Boolean        @default(true)
  /// Provider specifics: Instagram business account id, GBP account/location names, LinkedIn URN, posting defaults.
  settings          Json           @default("{}")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration   Integration?            @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  posts         SocialPost[]
  conversations Conversation[]
  metrics       ChannelMetricSnapshot[]

  @@unique([tenantId, platform, externalAccountId])
}

/// One row per channel per day from the platform's analytics API; the portal shows the trend.
model ChannelMetricSnapshot {
  id          String         @id @default(cuid())
  tenantId    String
  channelId   String
  platform    SocialPlatform
  /// UTC midnight of the day described.
  date        DateTime
  followers   Int?
  reach       Int?
  impressions Int?
  engagements Int?
  clicks      Int?
  posts       Int?
  raw         Json           @default("{}")
  createdAt   DateTime       @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
  @@index([tenantId, date])
}

enum ContentAssetKind {
  RAW_TEXT
  RAW_AUDIO
  RAW_VIDEO
  TRANSCRIPT
  HOOK
  QUOTE
  POST_COPY
  CAROUSEL
  YOUTUBE_META
  SHORT_FORM_SCRIPT
  IMAGE
  WEB_PAGE
  BLOG_POST
  AD_COPY
  EMAIL
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
}

/// Anything the content engine ingests or generates. Generated assets point back to their source via `parentId`.
model ContentAsset {
  id             String           @id @default(cuid())
  tenantId       String
  parentId       String?
  kind           ContentAssetKind
  title          String?
  body           String?
  fileUrl        String?
  targetPlatform SocialPlatform?
  status         ContentStatus    @default(DRAFT)
  /// True when the asset mentions prices, named people or claims and therefore needs client sign-off.
  needsClientSignoff Boolean      @default(false)
  tags           String[]         @default([])
  /// When the asset should go out; set at approval from the tenant's calendar slots.
  scheduledFor   DateTime?
  /// How it came to be: engine, model, hashtags, media brief, compliance report, origin of a source.
  generation     Json             @default("{}")
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     ContentAsset?  @relation("AssetLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children   ContentAsset[] @relation("AssetLineage")
  approvedBy User?          @relation("AssetApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  posts      SocialPost[]

  @@index([tenantId, status])
  @@index([tenantId, kind])
  @@index([tenantId, parentId])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

/// A single scheduled publication to one channel. One "post everywhere" action creates one row per channel sharing a `batchId`.
model SocialPost {
  id             String         @id @default(cuid())
  tenantId       String
  channelId      String?
  contentAssetId String?
  batchId        String?
  platform       SocialPlatform
  caption        String
  mediaUrls      String[]       @default([])
  tags           String[]       @default([])
  status         PostStatus     @default(DRAFT)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  externalPostId String?
  permalink      String?
  errorMessage   String?
  /// Publish attempts so far; the publisher gives up after three and raises an exception.
  attempts       Int            @default(0)
  /// Set while a tick is publishing the row; stale locks are reclaimable.
  lockedAt       DateTime?
  metrics        Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  contentAsset ContentAsset? @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, batchId])
}

enum SocialProofKind {
  TESTIMONIAL
  REVIEW
  CASE_STUDY
  SCREENSHOT
  VIDEO
  STAT
}

/// Reviews, testimonials and results the content engine can quote from.
model SocialProofAsset {
  id           String          @id @default(cuid())
  tenantId     String
  kind         SocialProofKind
  authorName   String?
  authorTitle  String?
  quote        String?
  rating       Int?
  sourceUrl    String?
  fileUrl      String?
  consentGiven Boolean         @default(false)
  capturedAt   DateTime?
  tags         String[]        @default([])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
}

// ---------------------------------------------------------------------------
// Finance (connector layer; extended in Phase 4)
// ---------------------------------------------------------------------------

enum FinanceProvider {
  SQUARE
  STRIPE
  XERO
  QUICKBOOKS
  MANUAL
}

enum TransactionKind {
  CONSULTATION_FEE
  RETAINER_DEPOSIT
  PAYMENT
  INVOICE
  REFUND
  EXPENSE
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  OVERDUE
}

/// Money in or out, from any connected finance provider, keyed on the provider's id per tenant.
model Transaction {
  id         String            @id @default(cuid())
  tenantId   String
  contactId  String?
  leadId     String?
  provider   FinanceProvider   @default(MANUAL)
  providerId String
  kind       TransactionKind   @default(PAYMENT)
  status     TransactionStatus @default(PENDING)
  amountCents Int
  currency   String            @default("USD")
  note       String?
  occurredAt DateTime
  rawPayload Json              @default("{}")
  createdAt  DateTime          @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, providerId])
  @@index([tenantId, occurredAt])
  @@index([contactId, status, occurredAt])
}

// ---------------------------------------------------------------------------
// Inventory (optional module, off by default)
// ---------------------------------------------------------------------------

enum InventoryType {
  LISTING
  CAPACITY
  STOCK
}

enum InventoryStatus {
  ACTIVE
  LOW
  UNAVAILABLE
  ARCHIVED
}

/// Whatever a business tracks when the inventory module is on: listings and rent roll, appointment capacity, or stock.
model InventoryItem {
  id         String          @id @default(cuid())
  tenantId   String
  type       InventoryType
  externalId String?
  name       String
  status     InventoryStatus @default(ACTIVE)
  quantity   Int?
  valueCents Int?
  attributes Json            @default("{}")
  source     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, status])
}

// ---------------------------------------------------------------------------
// Ads, attribution, invoices, website (Phase 4)
// ---------------------------------------------------------------------------

enum AdPlatform {
  META
  GOOGLE_ADS
}

/// A connected ad account. Credentials live on the tenant's META / GOOGLE_ADS Integration row.
model AdAccount {
  id                String     @id @default(cuid())
  tenantId          String
  platform          AdPlatform
  externalAccountId String
  name              String?
  currency          String     @default("AUD")
  /// Planned spend per calendar month, for pacing alerts.
  monthlyBudgetCents Int?
  isActive          Boolean    @default(true)
  lastSyncAt        DateTime?
  lastError         String?
  settings          Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots AdSpendSnapshot[]

  @@unique([tenantId, platform, externalAccountId])
}

/// Daily spend and results per campaign, from the platform's reporting API.
model AdSpendSnapshot {
  id            String     @id @default(cuid())
  tenantId      String
  adAccountId   String
  platform      AdPlatform
  /// UTC midnight of the day described.
  date          DateTime
  campaignId    String?
  campaignName  String?
  spendCents    Int
  impressions   Int?
  clicks        Int?
  platformLeads Int?
  raw           Json       @default("{}")
  createdAt     DateTime   @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, date, campaignId])
  @@index([tenantId, date])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

/// An invoice the tenant issued, mirrored from the finance provider so reminders and the Money panel can work from it.
model Invoice {
  id             String          @id @default(cuid())
  tenantId       String
  contactId      String?
  provider       FinanceProvider @default(MANUAL)
  externalId     String
  number         String?
  amountCents    Int
  amountDueCents Int
  currency       String          @default("AUD")
  status         InvoiceStatus   @default(SENT)
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  url            String?
  customerName   String?
  customerEmail  String?
  remindersSent  Int             @default(0)
  lastReminderAt DateTime?
  rawPayload     Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, status, dueAt])
}

/// A short link (/r/<code>) that stamps UTMs onto the destination and counts clicks, so offline and social placements attribute.
model TrackedLink {
  id          String   @id @default(cuid())
  tenantId    String
  code        String   @unique
  destination String
  label       String?
  source      String?
  medium      String?
  campaign    String?
  content     String?
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum WebEventKind {
  PAGEVIEW
  FORM_START
  FORM_SUBMIT
  LINK_CLICK
}

/// Raw website beacon hits, rolled up daily into SiteMetricSnapshot and pruned after 35 days.
model WebEvent {
  id         String       @id @default(cuid())
  tenantId   String
  kind       WebEventKind
  path       String?
  referrer   String?
  source     String?
  sessionKey String?
  occurredAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
}

/// One row per tenant per day of website numbers.
model SiteMetricSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime
  sessions    Int      @default(0)
  pageviews   Int      @default(0)
  formStarts  Int      @default(0)
  formSubmits Int      @default(0)
  linkClicks  Int      @default(0)
  topPages    Json     @default("{}")
  topSources  Json     @default("{}")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}

// ---------------------------------------------------------------------------
// Platform liveness and shared counters (pre-launch review, 25 Oct 2026)
// ---------------------------------------------------------------------------

/// Liveness marks written by background work (the scheduler tick) and read by the health endpoint and readiness.
model Heartbeat {
  key String   @id
  at  DateTime
}

/// Fixed-window counters shared by every instance: intake rate limits, sign-in lockouts, per-workspace daily caps.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
}

// ---------------------------------------------------------------------------
// Client onboarding (before a workspace exists)
// ---------------------------------------------------------------------------

enum OnboardingStatus {
  INVITED
  IN_PROGRESS
  SUBMITTED
  PROVISIONED
  CANCELLED
}

/// A client's onboarding questionnaire. Platform-level because the client has no workspace yet; `tenantId`
/// is filled in once one is made from it. The private link's token is stored only as a SHA-256 hash.
/// `answers` are the client's own words, validated against the form in src/lib/onboarding/form.ts.
model OnboardingSubmission {
  id            String           @id @default(cuid())
  tokenHash     String           @unique
  label         String
  contactEmail  String?
  status        OnboardingStatus @default(INVITED)
  answers       Json             @default("{}")
  createdById   String?
  tenantId      String?
  startedAt     DateTime?
  submittedAt   DateTime?
  provisionedAt DateTime?
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, updatedAt])
}
